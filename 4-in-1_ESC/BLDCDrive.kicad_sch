	(text_box "10nF cap for LPF "
		(exclude_from_sim no)
		(at 82.55 118.11 0)
		(size 13.97 6.35)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "59913be3-a220-4bbc-baab-59547fbea30d")
	)
	(text_box "FROM DATASHEET:\nQ_{TOT} = Q_{G} + (I_{LK_GS} + I_{QBS} + I_{LK_DIODE}) × T_{HON}\n\nLEAKAGE CURRENT SUM: \nI_{LK_GS} + I_{QBS} + I_{LK_DIODE} = 0.1u + 150u + 5u ~= 155uA \n\nT_{HON} = 10ms\n\nQ_{TOT} = Q_{G} + (LEAKAGE_CURRENT_SUM) × T_{HON}\n		= 42nC + 155uA*10ms = 42nC + 1550nC\n		~= 1.59uC\n--------------------------------------------------\nΔ_V_{BS} =< V_{CC} - V_{F} - V_{GSmin} - V_{DSon}\n \nV_{CC} = 10V\nV_{F} = 0.7 (DSF1D E1D)\nV_{GSmin} = 8V (V_{GSmin} > 7.5V (V_{BSUV} MAX))\nV_{DSon} = (R_{ds(on)} * phase current) (11mohm * 40A) 0.44V\n\nΔ_V_{BSmax} = 10 - 0.7 - 8 - 0.44 ~= 0.86V\n\nCBOOT_min = QTOT/Δ_V_{BSmax} = 1.59uC/0.86V ~= 1.85uF"
		(exclude_from_sim no)
		(at 31.75 27.333 0)
		(size 80.01 46.8855)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b0a18997-12c7-4e45-8439-49ab44864205")
	)
