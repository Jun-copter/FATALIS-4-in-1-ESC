	(text_box "SIGNALS & SENSORS\nPin     Function           Signal\nPA2     TIM2_CH3 (AF2)     DShot RX ← FC\nPA2     USART2_TX (AF1)    BDShot TX → FC (runtime switch)\nPA0     ADC_IN0            Phase current (shunt amp)\nPA1     ADC_IN1            Battery voltage (divider)\nPA4     ADC_IN4            NTC temperature\nPB6     USART1_TX (AF0)    Telemetry → FC\nPA13    SWDIO (AF0)        Debug probe\nPA14    SWCLK (AF0)        Debug probe"
		(exclude_from_sim no)
