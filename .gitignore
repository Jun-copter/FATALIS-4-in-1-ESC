# KiCad lock files (created while project is open)
*.lck

# KiCad local settings (window positions, layer visibility, etc.)
*.kicad_prl

# KiCad auto-backups
*-backups/

# KiCad auto-save
_autosave-*

# KiCad footprint cache
fp-info-cache

# Gerber / fabrication output
gerbers/
fab/
plot/
*.gbr
*.drl
*.dxf
*.pdf
*.svg
*.pos
*.rpt
*.xml
*.csv

# LCSC import script (local tooling, not part of the design source)
add-lcsc-part.ps1

# Python cache (from KiCad scripting or easyeda2kicad)
__pycache__/
*.pyc

# Windows
Thumbs.db
desktop.ini
